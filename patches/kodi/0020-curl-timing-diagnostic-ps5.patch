ps5: temporary easy_reset timing instrumentation (diagnostic).

Add-on installs stall for tens of seconds per file though the bytes arrive in
~1s. To locate the cost, log (PS5 only) how long curl_easy_reset() in
easy_release() takes when it exceeds 50 ms - the one per-transfer curl call on
the install worker's hot path that 0016 did not already move off-thread. No
behaviour change; revert once identified.
--- a/xbmc/filesystem/DllLibCurl.cpp
+++ b/xbmc/filesystem/DllLibCurl.cpp
@@ -317,7 +317,18 @@
     {
       /* reset session so next caller doesn't reuse options, only connections */
       /* will reset verbose too so it won't print that it closed connections on cleanup*/
+#if defined(TARGET_PS5)
+      {
+        auto _t0 = std::chrono::steady_clock::now();
+        easy_reset(easy);
+        auto _ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now() - _t0).count();
+        if (_ms > 50)
+          CLog::Log(LOGINFO, "PS5 curl-timing: easy_reset took {} ms", _ms);
+      }
+#else
       easy_reset(easy);
+#endif
       it.m_busy = false;
       it.m_idletimestamp = std::chrono::steady_clock::now();
       return;
